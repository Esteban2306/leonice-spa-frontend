NEXT_PUBLIC_API_URL=http://localhost:3920/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SPA_WHATSAPP=573144518129
NEXT_PUBLIC_DEV_AUTH_BYPASS=false

# Modo de caché de la web pública (se fija al compilar; cambiarlo exige un nuevo despliegue).
#   economy (por defecto): 1 hora. Pensado para el plan gratuito de Cloudflare (KV: 1.000 escrituras/día).
#   fresh: 60 s los testimonios y 300 s lo demás. Los cambios del panel se ven casi al instante,
#          pero gasta muchas más escrituras en KV; usar con el plan de pago.
# En Cloudflare se define en Workers & Pages > leonice-spa > Settings > Build > Variables.
PUBLIC_CACHE_MODE=economy
